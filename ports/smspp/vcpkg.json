{
  "name": "smspp",
  "version": "0.6.0",
  "description": "A C++17 framework for modeling and solving block-structured mathematical optimization problems",
  "homepage": "https://gitlab.com/smspp/smspp-project",
  "license": "LGPL-3.0-only",
  "dependencies": [
    "boost-algorithm",
    "boost-any",
    "boost-bimap",
    "boost-function",
    "boost-functional",
    "boost-multi-array",
    "eigen3",
    "netcdf-cxx4"
  ],
  "default-features": [
    "bds",
    "bkb",
    "bnx",
    "bundle",
    "cflb",
    "frankwolfe",
    "investment",
    "lds",
    "lukfi",
    "mcf",
    "mcfclass",
    "mcflemon",
    "milp",
    "mmcf",
    "mssb",
    "sddp",
    "sfdcr",
    "srs",
    "stochastic",
    "svm",
    "tools",
    "tssb",
    "ucblock"
  ],
  "features": {
    "bds": {
      "description": "Generic Benders decomposition Solver"
    },
    "bkb": {
      "description": "Binary knapsack Block and its dynamic programming Solver"
    },
    "bnx": {
      "description": "Relaxation-agnostic Branch-and-X Solver"
    },
    "bundle": {
      "description": "Bundle methods for nondifferentiable optimization",
      "dependencies": [
        "bzip2",
        "coin-or-clp",
        "coin-or-osi",
        "coinutils",
        "zlib",
        {
          "name": "smspp",
          "default-features": false,
          "features": [
            "milp"
          ]
        }
      ]
    },
    "cflb": {
      "description": "Capacitated facility location Block",
      "dependencies": [
        {
          "name": "smspp",
          "default-features": false,
          "features": [
            "bkb",
            "mcf"
          ]
        }
      ]
    },
    "frankwolfe": {
      "description": "Frank-Wolfe and Dantzig-Wolfe decomposition Solver"
    },
    "investment": {
      "description": "Investment (capacity expansion) Block",
      "dependencies": [
        "boost-serialization",
        {
          "name": "smspp",
          "default-features": false,
          "features": [
            "sddp",
            "tssb",
            "ucblock"
          ]
        }
      ]
    },
    "lds": {
      "description": "Lagrangian dual Solver",
      "dependencies": [
        {
          "name": "smspp",
          "default-features": false,
          "features": [
            "milp"
          ]
        }
      ]
    },
    "lukfi": {
      "description": "Test functions for nonsmooth optimization"
    },
    "mcf": {
      "description": "Min-cost flow Block"
    },
    "mcfclass": {
      "description": "Min-cost flow Solvers of MCFClass",
      "dependencies": [
        {
          "name": "smspp",
          "default-features": false,
          "features": [
            "mcf"
          ]
        }
      ]
    },
    "mcflemon": {
      "description": "Min-cost flow Solvers of LEMON",
      "dependencies": [
        "liblemon",
        {
          "name": "pthreads",
          "platform": "windows"
        },
        {
          "name": "smspp",
          "default-features": false,
          "features": [
            "mcf"
          ]
        }
      ]
    },
    "milp": {
      "description": "MILP Solvers, here on HiGHS",
      "dependencies": [
        "boost-preprocessor",
        "highs"
      ]
    },
    "mmcf": {
      "description": "Multicommodity min-cost flow Block",
      "dependencies": [
        {
          "name": "smspp",
          "default-features": false,
          "features": [
            "bkb",
            "mcf"
          ]
        }
      ]
    },
    "mssb": {
      "description": "Multi-stage stochastic Block",
      "dependencies": [
        {
          "name": "smspp",
          "default-features": false,
          "features": [
            "tssb"
          ]
        }
      ]
    },
    "sddp": {
      "description": "Stochastic Dual Dynamic Programming Block",
      "dependencies": [
        "boost-iostreams",
        "boost-mpi",
        {
          "name": "msmpi",
          "platform": "windows"
        },
        {
          "name": "smspp",
          "default-features": false,
          "features": [
            "stochastic"
          ]
        },
        "stopt"
      ]
    },
    "sfdcr": {
      "description": "Single-flow delay-constrained routing Block"
    },
    "srs": {
      "description": "Scenario reduction Solvers",
      "dependencies": [
        {
          "name": "smspp",
          "default-features": false,
          "features": [
            "tssb"
          ]
        }
      ]
    },
    "stochastic": {
      "description": "Stochastic Block and scenario sets",
      "dependencies": [
        {
          "name": "smspp",
          "default-features": false,
          "features": [
            "cflb"
          ]
        }
      ]
    },
    "svm": {
      "description": "Support Vector Machine Block",
      "dependencies": [
        "liblinear",
        "libsvm"
      ]
    },
    "tools": {
      "description": "The command-line tools of the enabled modules, e.g. ucblock_solver, installed in tools/smspp",
      "dependencies": [
        {
          "name": "getopt",
          "platform": "windows"
        }
      ]
    },
    "tssb": {
      "description": "Two-stage stochastic Block",
      "dependencies": [
        {
          "name": "smspp",
          "default-features": false,
          "features": [
            "stochastic"
          ]
        }
      ]
    },
    "ucblock": {
      "description": "Unit Commitment Block, its units and networks"
    }
  }
}
